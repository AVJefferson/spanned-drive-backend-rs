          "new_logical_folder_name": { "type": "string", "minLength": 1 },
          "drives": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [{ "type": "string" }, { "type": "string" }],
              "minItems": 2,
              "maxItems": 2
